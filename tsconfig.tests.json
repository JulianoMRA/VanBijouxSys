{
  "extends": "./tsconfig.node.json",
  "include": ["src/tests/**/*", "src/main/**/*", "src/shared/**/*", "src/renderer/src/**/*"],
  "compilerOptions": {
    "composite": true,
    // Os testes de tela renderizam componentes React: precisam do JSX e do DOM,
    // além do node que os testes de lógica usam.
    "jsx": "react-jsx",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["node", "vite/client"],
    "tsBuildInfoFile": "node_modules/.tmp/tsconfig.tests.tsbuildinfo"
  }
}
