{
  "extends": "./tsconfig.node.json",
  "include": [
    "src/tests/**/*",
    "src/main/**/*",
    "src/shared/**/*",
    "src/renderer/src/types/**/*",
    "src/renderer/src/utils/**/*"
  ],
  "compilerOptions": {
    "composite": true,
    "types": ["node"],
    "tsBuildInfoFile": "node_modules/.tmp/tsconfig.tests.tsbuildinfo"
  }
}
